<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.petplatform.schedule.biz.infrastructure.persistence.mapper.ScheduleReadMapper">

    <!-- C-end visibility: SOLD_OUT stays listed with remaining=0/available=false, matching the
         presentation an at-capacity OPEN window already had (Contract53 §3, 2026-10-05).
         CCR-SCH-SLOT-001: the slot timeline is store-wide; every service of the store shares
         the configured slot capacity (CCR-SCH-STAFF-OFFLINE-001 removed the staff minimum). -->
    <select id="selectOpenWindows"
            resultType="com.petplatform.schedule.biz.infrastructure.persistence.entity.ScheduleAvailabilityWindowEntity">
        SELECT id,
               merchant_id,
               store_id,
               start_at,
               end_at,
               configured_capacity,
               status,
               version
        FROM schedule_availability_window
        WHERE store_id = #{storeId}
          AND status IN ('OPEN', 'SOLD_OUT')
          AND start_at &lt; #{toAt}
          AND end_at &gt; #{fromAt}
        ORDER BY start_at, id
    </select>

    <!-- Single pool (CCR-SCH-SLOT-001): every effective claim on the slot counts, regardless
         of which service made it — the SOLD_OUT deriver's occupancy notion. -->
    <select id="countActiveClaimsOnWindow" resultType="long">
        SELECT COUNT(*)
        FROM schedule_reservation_claim c
        JOIN schedule_reservation r ON r.id = c.reservation_id
        WHERE c.window_id = #{windowId}
          AND r.status IN ('TEMP_LOCKED', 'CONFIRMED')
    </select>

    <!-- SCH-004 merchant workbench reads: full states incl. CLOSED, status filter optional.
         The filter fragment is shared with the pagination count so total always matches the
         listed rows (53号 §3.3, 2026-10-07; CCR-SCH-SLOT-001 drops service/kind filters). -->
    <sql id="workbenchWindowFilters">
        WHERE store_id = #{storeId}
        <if test="status != null">AND status = #{status}</if>
    </sql>
    <select id="listWindows" resultType="map">
        SELECT id, merchant_id, store_id, start_at, end_at,
               configured_capacity, status, version, updated_at
        FROM schedule_availability_window
        <include refid="workbenchWindowFilters"/>
        ORDER BY start_at, id
        <if test="limit != null">LIMIT #{limit} OFFSET #{offset}</if>
    </select>
    <select id="countWindows" resultType="long">
        SELECT COUNT(*)
        FROM schedule_availability_window
        <include refid="workbenchWindowFilters"/>
    </select>
</mapper>
