# 支付中心（拉卡拉）环境变量模板 —— CCR-PAY-CENTER-001
#
# 使用方法：复制本文件为同目录下的 payment-center.env.local 再填写真实值。
#   payment-center.env.local 已被 .gitignore（ops/*.local）忽略，不会被提交。
#   请勿把真实值、测试私钥或 SM4 密钥写进本模板或任何入库文件。
#
# 密钥和证书只填写"文件路径"，文件本身放在仓库之外（例如 /etc/pet-platform/lakala/）。
# application.yml 用 ${...} 读取这些变量（pet.payment.*）；没有列出的变量表示当前阶段尚未映射。

# ---------- 环境 ----------
# SIT（拉卡拉测试环境）或 PRODUCTION（代码枚举名；写 PROD 会启动失败）
LAKALA_ENV=SIT

# ---------- 开放平台接入身份（拉卡拉分配） ----------
# 接入方唯一编号 appid，例如 OP0000xxxx
LAKALA_APP_ID=
# 接入方证书序列号 serial_no（与下面的私钥对应）
LAKALA_MERCHANT_SERIAL_NO=
# 接入方请求加签私钥（PKCS#8 PEM）文件路径
LAKALA_MERCHANT_PRIVATE_KEY_PATH=
# 拉卡拉平台公钥证书序列号（普通响应验签）
LAKALA_PLATFORM_CERT_SERIAL=
# 拉卡拉平台公钥证书文件路径（普通响应验签）
LAKALA_PLATFORM_CERT_PATH=
# 拉卡拉异步通知验签证书文件路径（如 lkl-apigw-v2.cer；SDK 说明当前与平台证书相同，仍单独配置）
LAKALA_NOTIFY_CERT_PATH=
# 国密 SM4 密钥（仅全报文加密接口需要；不用加密接口可留空）
LAKALA_SM4_KEY=

# ---------- 平台收单商户（唯一收单商户，商户进件产生） ----------
# 平台商户号 merchant_no（822 开头）
LAKALA_MERCHANT_NO=
# 平台终端号 term_no
LAKALA_TERM_NO=
# 三项平台商户配置（MERCHANT_NO/TERM_NO/WECHAT_MINI_APP_ID）须同时填写；且不可与 pet.payment.lakala.stores.* 同时配置
# 预下单 settle_type：1=接分账，0=常规结算（不上送）。取值只能 0 或 1。
# 缺省 0。阶段 2 分账能力落地前，生产不得使用 1（资金会进入待分账）；SIT 联调分账标识时显式改为 1。
LAKALA_SETTLE_TYPE=0
# 预下单 out_org_code（现有协议必填；取值待向拉卡拉确认，是否等于 appid 或机构号）
LAKALA_OUT_ORG_CODE=
# 拉卡拉机构号（接收方/绑定接口的 orgCode、账管家接口的 orgNo、分账接口的 lklOrgNo；如三者不同请告知）
LAKALA_ORG_CODE=

# ---------- 微信小程序 ----------
# 小程序 AppID（wx 开头），作为预下单 sub_appid；须已与拉卡拉商户的微信子商户关联
WECHAT_MINI_APP_ID=

# ---------- 回调地址（外网可达的 HTTPS） ----------
# 支付结果通知（1112）
LAKALA_PAY_NOTIFY_URL=
# 退货通知（1904）
LAKALA_REFUND_NOTIFY_URL=
# 分账/回退结果通知（1297）
LAKALA_SEPARATE_NOTIFY_URL=
# 提现结果通知（1272）
LAKALA_WITHDRAW_NOTIFY_URL=
# 接收方创建/绑定审核结果通知（1287/1290 的 retUrl）
LAKALA_LEDGER_NOTIFY_URL=

# ---------- 渠道约定 ----------
# 渠道时间字段时区，须向拉卡拉核实后填写（例如 Asia/Shanghai）；未填写时支付成功不入账（失败关闭）
LAKALA_CHANNEL_TIMEZONE=
# 预下单上送的终端 IP（服务器出口 IP）
LAKALA_REQUEST_IP=
# 交易标题 subject
LAKALA_SUBJECT=
# 平台（分账方）最低分得比例，与委托书"本商户最低需分得"及 1284 splitLowestRatio 一致；小数，例如 0 或 0.005（0.5%）
LAKALA_SPLIT_LOWEST_RATIO=0

# ---------- 本地加密密钥（平台自行生成，不来自拉卡拉） ----------
# 加密保存微信短期支付参数的 AES-256 密钥文件路径
PAYMENT_PARAM_AES_KEY_PATH=
# 加密保存接收方银行卡号/证件号/手机号的 AES-256 密钥文件路径
SETTLEMENT_RECEIVER_AES_KEY_PATH=

# ---------- 支付中心开关（75 号契约 §8；全部缺省 false，不注册任何 HTTP） ----------
# 装配 PaymentCenterApi/PaymentCenterFactsApi；要求 PAYMENT_FOUNDATION_ENABLED 与 PAYMENT_DISPATCH_ENABLED 同为 true，且平台商户三项已填
PAYMENT_CENTER_ENABLED=false
# PAYMENT_CHANNEL_QUERY 查单 worker；要求 PAYMENT_CENTER_ENABLED=true
PAYMENT_CENTER_WORKER_ENABLED=false
# 测试专用 DEMO 业务方；要求 PAYMENT_CENTER_ENABLED=true、Outbox 开启，且 LAKALA_ENV=SIT（否则启动失败）
PAYMENT_CENTER_DEMO_ENABLED=false
# DEMO 单笔金额上限（元，最多 2 位小数）
PAYMENT_CENTER_DEMO_MAX_AMOUNT=0.01
