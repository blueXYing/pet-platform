# ==============================================================================
# 宠物平台 V1.0 后端敏感配置与机器路径模板（唯一环境变量清单）
# ------------------------------------------------------------------------------
# 使用方法：
#   - 本地开发：复制为仓库根目录 .env.local（已加入 .gitignore），启动时指定
#     SPRING_PROFILES_ACTIVE=dev，Spring Boot 会自动读取 .env.local。
#   - 测试/生产：由 systemd / 容器 / CI 秘密管理注入下列环境变量，并指定
#     SPRING_PROFILES_ACTIVE=test 或 prod。
#   - 严禁把真实密钥、密码、私钥或证书内容提交进 Git 仓库。
#
# 本文件只列「密钥、密码、机器路径与环境地址」，不再重复任何非敏感业务默认值。
# ==============================================================================

# ---------- 1. 数据库与 Redis（全模块共用同一套 Redis） ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pet_platform
DB_USER=pet
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- 2. 管理端会话与审计（平台自签，三把密钥须互不相同） ----------
# 生产与公网穿透须填 https://<管理端域名>；开发环境 application-dev.yml 默认 http://127.0.0.1:8090
ADMIN_AUTH_ORIGIN=
ADMIN_AUTH_KEY_ID=
# 生成命令：openssl rand -base64 32
ADMIN_AUTH_MAC_KEY_BASE64=
ADMIN_AUTH_ENCRYPTION_KEY_BASE64=
# 宿主机可写审计文件路径（如 /var/log/pet/admin-audit.log）
ADMIN_AUTH_AUDIT_PATH=
# Snowflake 节点号（0..1023，单实例默认 1，多实例互异）
SNOWFLAKE_NODE_ID=1

# ---------- 3. 微信小程序（C 端登录与拉卡拉预下单 sub_appid 共用） ----------
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=

# ---------- 4. 对象存储 OSS（私有素材 / 社区 / 营销共用） ----------
OSS_ENDPOINT=
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_SECRET_ACCESS_KEY=
# 可选 CDN 公网基底（如 https://cdn.example.com）
OSS_PUBLIC_BASE_URL=

# 私有素材授权/理由密钥 + ClamAV 扫描服务
PRIVATE_ASSET_GRANT_KEY_VERSION=v1
PRIVATE_ASSET_GRANT_HMAC_KEY_BASE64=
PRIVATE_ASSET_REASON_KEY_VERSION=v1
PRIVATE_ASSET_REASON_AES_KEY_BASE64=
PRIVATE_ASSET_CLAMAV_HOST=
PRIVATE_ASSET_CLAMAV_PORT=3310
PRIVATE_ASSET_CLAMAV_TIMEOUT_MILLIS=15000

# ---------- 5. 业务域加密/保护密钥（openssl rand -base64 32） ----------
MERCHANT_SUBJECT_POLICY_VERSION=v1
MERCHANT_SUBJECT_HMAC_KEY_BASE64=
MERCHANT_PROTECTED_KEY_VERSION=v1
MERCHANT_PROTECTED_AES_KEY_BASE64=
MERCHANT_PROTECTED_HMAC_KEY_BASE64=
ORDER_MERCHANT_PROTECTION_KEY=
REFUND_APPLICATION_PROTECTION_KEY=
VERIFICATION_CREDENTIAL_KEY_ID=v1
VERIFICATION_CREDENTIAL_ENCRYPTION_KEY=
VERIFICATION_CREDENTIAL_LOOKUP_KEY=
AFTERSALE_PROTECTION_KEY=

# ---------- 6. 拉卡拉支付与退款（密钥/证书只填宿主机文件路径，文件放仓库外；开发用测试商户证书，上线替换正式证书） ----------
LAKALA_APP_ID=
LAKALA_MERCHANT_SERIAL_NO=
LAKALA_MERCHANT_PRIVATE_KEY_PATH=
LAKALA_PLATFORM_CERT_SERIAL=
LAKALA_PLATFORM_CERT_PATH=
LAKALA_NOTIFY_CERT_PATH=
# 微信短期支付参数 AES-256 密钥文件路径
PAYMENT_PARAM_AES_KEY_PATH=
# 接收方敏感信息 AES-256 密钥文件路径（分账/提现阶段）
SETTLEMENT_RECEIVER_AES_KEY_PATH=
# 国密 SM4 密钥（仅全报文加密接口需要，不用可留空）
LAKALA_SM4_KEY=

# 平台主体商户（模式 A 下用于平台主体身份/DEMO/接收方默认绑定；各商家收单商户号与终端号在运营后台 settlement_config 录入）
LAKALA_MERCHANT_NO=
LAKALA_TERM_NO=
# 模式 A 平台分账接收方编号（支持 SR... 或 82... 平台商户号，如 822651053990MW8；用于 1293 向平台回分手续费及 2395 退款回退）
LAKALA_PLATFORM_RECEIVER_NO=
LAKALA_OUT_ORG_CODE=
LAKALA_ORG_CODE=
# 收单分账标识：0 普通收单，1 分账收单（开通拉卡拉分账权限后设为 1）
LAKALA_SETTLE_TYPE=0
# 委托书"本商户最低需分得"比例（小数 [0,1)，默认 0；如 5% 填 0.05）
LAKALA_SPLIT_LOWEST_RATIO=0
LAKALA_SUBJECT=
# 预下单终端 IP（服务器出口 IP）
LAKALA_REQUEST_IP=
# 回调地址（外网可达 HTTPS）
LAKALA_PAY_NOTIFY_URL=
LAKALA_REFUND_NOTIFY_URL=
LAKALA_SEPARATE_NOTIFY_URL=
LAKALA_WITHDRAW_NOTIFY_URL=
LAKALA_LEDGER_NOTIFY_URL=

# 商家收单开通（CCR-PAY-ONBOARD-001 / 契约 81）：以下为与拉卡拉立项约定的平台级参数，均非密钥；留空时后台「发起开通」失败关闭并提示缺项
# 开通链路回调基址（外网可达）；代码追加 /ec、/ledger-open、/bind，进件回调打在基址本身（1020 限制 retUrl ≤64 字符）
LAKALA_ONBOARDING_NOTIFY_BASE_URL=
# 进件 POS 类型（POS 类型字典表）
LAKALA_ONBOARDING_POS_TYPE=
# 经营内容字典值（如 654）
LAKALA_ONBOARDING_MER_BUSI_CONTENT=
# 结算周期字典值（如 T+1）
LAKALA_ONBOARDING_SETTLE_PERIOD=
# 进件费率集合 JSON 数组，如 [{"feeRateTypeCode":"302","feeRateTypeName":"微信","feeRatePct":"0.60"}]
LAKALA_ONBOARDING_FEE_RATES_JSON=
# 银联 MCC 默认值，以及按商家类型映射的 JSON 对象（键为商家类型代码）
LAKALA_ONBOARDING_MCC_DEFAULT=
LAKALA_ONBOARDING_MCC_BY_TYPE_JSON=
# 平台城市码 → 拉卡拉地区码 的 JSON 对象
LAKALA_ONBOARDING_DISTRICT_BY_CITY_JSON=
# 委托书"本商户最低需分得"比例，百分数且最多两位小数（如 90 或 90.50）
LAKALA_ONBOARDING_LOWEST_RATIO=
# 电子合同 E2：平台与商家的合作协议名称
LAKALA_ONBOARDING_COOPERATION_AGREEMENT_NAME=
# 电子合同 E1/E9：平台公司全称
LAKALA_ONBOARDING_PLATFORM_NAME=
# 电子合同的数字机构号；留空时复用数字形式的 LAKALA_ORG_CODE（机构代码不是纯数字时必须单独填）
LAKALA_ONBOARDING_EC_ORG_ID=
